# Path to a reviewed Ultralytics YOLO .pt model whose class names include
# one or more entries from ACCIDENT_CLASSES. See README.md for the starter model.
MODEL_PATH=models/accident.pt
ACCIDENT_CLASSES=accident,crash,collision
CONFIDENCE_THRESHOLD=0.45
INFERENCE_SIZE=416
CONFIRM_FRAMES=1
ALERT_COOLDOWN_SECONDS=60

# Optional responder endpoint that accepts a JSON POST for each confirmed event.
ALERT_WEBHOOK_URL=

# Android SMS-gateway app must accept HTTP POST JSON with "to" and "message" fields.
# Keep the phone and this PC on the same network; optional bearer token for the gateway.
SMS_GATEWAY_URL=
SMS_RECIPIENT=
SMS_GATEWAY_TOKEN=

# Gmail SMTP: create an App Password in your Google Account and keep it private here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# For public hosting, set PUBLIC_DEPLOYMENT=true and choose a strong unique password.
# Basic authentication must be served through HTTPS (for example, behind Caddy).
PUBLIC_DEPLOYMENT=false
APP_USERNAME=
APP_PASSWORD=
ROADGUARD_DOMAIN=roadguard.example.com

DATA_DIR=data
HOST=127.0.0.1
PORT=8000
